{
  "expo": {
    "name": "Training Lab",
    "slug": "hackcamp-training-lab",
    "orientation": "portrait",
    "ios": { "bundleIdentifier": "com.hackcamp.traininglab" },
    "android": {
      "package": "com.hackcamp.traininglab",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Allow Training Lab to track exercise reps using your camera.",
        "recordAudioAndroid": false
      }]
    ]
  }
}
